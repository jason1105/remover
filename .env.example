# ---- LLM 配置 (用于翻译 / 总结 / 分类) ----
# 不设置 LLM_API_KEY 时，应用会使用模拟输出，流水线依然可完整运行。
# 在 Vercel: Project Settings → Environment Variables 中配置。

LLM_API_KEY=
# OpenAI 兼容的 Base URL (默认 https://api.openai.com/v1)
LLM_BASE_URL=https://api.openai.com/v1
# 模型名 (默认 gpt-4o-mini)；也可指向任意 OpenAI 兼容服务的模型
LLM_MODEL=gpt-4o-mini

# 可选：保护定时任务接口的密钥 (Vercel Cron 会带上 Authorization)
CRON_SECRET=
